generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model designations {
  id    Int     @id @default(autoincrement())
  title String? @db.VarChar(50)
  staff staff[]
}

model expense_categories {
  category_id   Int        @id @default(autoincrement())
  category_name String?    @db.VarChar(50)
  expenses      expenses[]
}

model expenses {
  expense_id         Int                 @id @default(autoincrement())
  category_id        Int?
  amount             Decimal             @db.Decimal(12, 2)
  description        String?
  created_at         DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  expense_categories expense_categories? @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
}

model fee_payments {
  payment_id     Int       @id @default(autoincrement())
  student_id     Int?
  academic_month DateTime  @db.Date
  amount_due     Decimal?  @db.Decimal(10, 2)
  amount_paid    Decimal?  @default(0) @db.Decimal(10, 2)
  payment_date   DateTime? @default(now()) @db.Timestamp(6)
  students       students? @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, academic_month], map: "unique_student_month")
}

model roles {
  role_id   Int     @id @default(autoincrement())
  role_name String  @unique @db.VarChar(20)
  users     users[]
}

model staff {
  staff_id       Int           @id @default(autoincrement())
  name           String        @db.VarChar(100)
  staff_code     String        @db.VarChar(20)
  cnic           String        @unique @db.VarChar(15)
  phone_no       String?       @db.VarChar(15)
  salary         Decimal?      @db.Decimal(12, 2)
  designation_id Int?
  designations   designations? @relation(fields: [designation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?

  @@unique([name, staff_code])
}

model students {
  student_id     Int            @id @default(autoincrement())
  roll_no        Int
  section        String         @db.VarChar(10)
  class          String         @db.VarChar(10)
  first_name     String         @db.VarChar(50)
  last_name      String         @db.VarChar(50)
  father_name    String?        @db.VarChar(100)
  contact_1      String?        @db.VarChar(15)
  contact_2      String?        @db.VarChar(15)
  address        String?
  admission_date DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  fee_payments   fee_payments[]

  @@unique([roll_no, section, class])
}

model users {
  user_id       Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  password_hash String    @db.VarChar(255)
  role_id       Int?
  staff_id      Int?      @unique
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  last_login    DateTime? @db.Timestamp(6)
  roles         roles?    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
  staff         staff?    @relation(fields: [staff_id], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
}
